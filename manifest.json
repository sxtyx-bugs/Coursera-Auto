{
  "manifest_version": 3,
  "name": "Coursera Assistant — Editorial Edition",
  "version": "1.3.0",
  "version_name": "1.3.0",
  "author": "satydev & satuxcodes",
  "homepage_url": "https://github.com/sxtyx-bugs",
  "description": "Swiss Editorial white skeuomorphic Coursera assistant by satydev & satuxcodes. Auto-complete lectures & readings, solve quizzes with Gemini, and advance dialogues.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "commands"
  ],
  "action": {
    "default_popup": "dist/popup.html",
    "default_icon": {
      "16": "dist/assets/1.png",
      "32": "dist/assets/2.png",
      "48": "dist/assets/3.png",
      "128": "dist/assets/4.png"
    }
  },
  "icons": {
    "16": "dist/assets/1.png",
    "32": "dist/assets/2.png",
    "48": "dist/assets/3.png",
    "128": "dist/assets/4.png"
  },
  "background": {
    "service_worker": "dist/scripts/background.js"
  },
  "options_page": "dist/settings.html",
  "content_scripts": [
    {
      "run_at": "document_end",
      "matches": [
        "*://*.coursera.org/learn*",
        "*://*.coursera.org/*"
      ],
      "js": [
        "dist/scripts/model-provider.js",
        "dist/scripts/content.js",
        "dist/scripts/dialogue.js"
      ],
      "css": [
        "dist/ui/content.css"
      ]
    },
    {
      "run_at": "document_start",
      "matches": [
        "*://*.coursera.org/learn*",
        "*://*.coursera.org/*"
      ],
      "js": [
        "dist/scripts/interceptor.js"
      ],
      "world": "MAIN"
    }
  ],
  "commands": {
    "open_popup_1": {
      "suggested_key": {
        "default": "Alt+B",
        "mac": "Command+B"
      },
      "description": "Open the Coursera Assistant popup window with Alt+B"
    },
    "open_popup_2": {
      "suggested_key": {
        "default": "Alt+W",
        "mac": "Command+W"
      },
      "description": "Open the Coursera Assistant popup window with Alt+W"
    }
  },
  "host_permissions": [
    "*://*.coursera.org/*",
    "https://generativelanguage.googleapis.com/*"
  ]
}